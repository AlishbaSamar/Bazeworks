generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  workspaceMemberships WorkspaceMember[]
  ownedWebsites        Website[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String?
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   WorkspaceMember[]
  websites  Website[]
  templates Template[]

  @@map("workspace")
}

model WorkspaceMember {
  id        String        @id @default(cuid())
  role      WorkspaceRole
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_member")
}

enum WebsiteStatus {
  DRAFT
  LIVE
}

model Website {
  id           String        @id @default(cuid())
  name         String
  slug         String
  status       WebsiteStatus @default(DRAFT)
  theme        Json          @default("{}")
  globalHeader Json          @default("{}")
  globalFooter Json          @default("{}")
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  pages       Page[]
  collections Collection[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("website")
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

model Page {
  id        String     @id @default(cuid())
  name      String
  slug      String
  status    PageStatus @default(DRAFT)
  order     Int        @default(0)
  content   Json       @default("{\"content\":[],\"root\":{}}")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  // A dynamic page renders one collection entry per URL — e.g. a page with
  // slug "blog" and dynamicSlugField "slug" resolves "/blog/hello-world" by
  // looking up the entry in dynamicCollection whose data.slug === "hello-world".
  isDynamic           Boolean     @default(false)
  dynamicCollectionId String?
  dynamicCollection   Collection? @relation(fields: [dynamicCollectionId], references: [id], onDelete: SetNull)
  dynamicSlugField    String?

  @@unique([websiteId, slug])
  @@index([websiteId])
  @@index([dynamicCollectionId])
  @@map("page")
}

enum CollectionFieldType {
  TEXT
  TEXTAREA
  RICH_TEXT
  NUMBER
  BOOLEAN
  DATE
  DATE_TIME
  IMAGE
  FILE
  URL
  EMAIL
  SELECT
  MULTI_SELECT
  RELATION
}

model Collection {
  id        String   @id @default(cuid())
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  fields  CollectionField[] @relation("CollectionFields")
  entries CollectionEntry[]

  // Other collections' relation-type fields that point at this collection —
  // named separately from `fields` since both relations target Collection.
  incomingRelationFields CollectionField[] @relation("CollectionFieldRelation")

  // Pages that render this collection's entries dynamically (e.g. a "blog" page
  // bound to this collection renders /blog/[slug] for each of its entries).
  dynamicPages Page[]

  @@unique([websiteId, slug])
  @@index([websiteId])
  @@map("collection")
}

model CollectionField {
  id        String              @id @default(cuid())
  name      String
  key       String
  type      CollectionFieldType
  required  Boolean             @default(false)
  options   Json                @default("[]")
  order     Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  collectionId String
  collection   Collection @relation("CollectionFields", fields: [collectionId], references: [id], onDelete: Cascade)

  relatedCollectionId String?
  relatedCollection   Collection? @relation("CollectionFieldRelation", fields: [relatedCollectionId], references: [id])

  @@unique([collectionId, key])
  @@index([collectionId])
  @@index([relatedCollectionId])
  @@map("collection_field")
}

model CollectionEntry {
  id        String     @id @default(cuid())
  data      Json       @default("{}")
  status    PageStatus @default(DRAFT)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([collectionId, createdAt])
  @@index([collectionId, status, createdAt])
  @@map("collection_entry")
}

enum TemplateKind {
  SITE
  PAGE
}

model Template {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String
  category    String
  kind        TemplateKind @default(SITE)
  isOfficial  Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Null for official templates maintained by platform admins. Set when a
  // user saves one of their own websites (or pages) as a reusable template —
  // those are only visible inside the owning workspace.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById String?

  // Snapshot of the source website's design, copied verbatim into any new
  // website created from this template.
  theme        Json @default("{}")
  globalHeader Json @default("{}")
  globalFooter Json @default("{}")

  pages       TemplatePage[]
  collections TemplateCollection[]

  @@index([workspaceId])
  @@map("template")
}

model TemplatePage {
  id      String @id @default(cuid())
  name    String
  slug    String
  order   Int    @default(0)
  content Json   @default("{\"content\":[],\"root\":{}}")

  // A template can't reference real Collection ids (they don't exist until a
  // website is created from it), so a dynamic page's binding is stored by the
  // template collection's slug and resolved to a real id during the copy.
  isDynamic             Boolean @default(false)
  dynamicCollectionSlug String?
  dynamicSlugField      String?

  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, slug])
  @@map("template_page")
}

model TemplateCollection {
  id    String @id @default(cuid())
  name  String
  slug  String
  order Int    @default(0)

  // Field definitions as a JSON array — same shape the CMS field builder
  // produces: { name, key, type, required, options, order, relatedCollectionSlug }.
  fields  Json @default("[]")
  // Sample entries as a JSON array: { data, status }.
  entries Json @default("[]")

  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, slug])
  @@map("template_collection")
}
