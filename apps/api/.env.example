DATABASE_URL="postgresql://user:password@host:5432/dbname"

PORT=4000
WEB_APP_URL="http://localhost:3000"

# Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET="change-me"

# Better Auth serves OAuth callbacks itself at {baseURL}/api/auth/callback/{provider} —
# register these exact URLs in the Google/GitHub OAuth app consoles:
#   http://localhost:4000/api/auth/callback/google
#   http://localhost:4000/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# EMAIL_VERIFICATION_MODE=test overrides EMAIL_PROVIDER below and forces the
# mailer to just console.log the verification/reset link instead of sending
# it for real. Use this on hosts that block outbound SMTP/provider traffic
# (Railway blocks Gmail SMTP) until a real sending domain is configured.
# Leave unset (or set to anything else) to use EMAIL_PROVIDER normally.
EMAIL_VERIFICATION_MODE=test

# EMAIL_PROVIDER picks which one below actually sends mail: "gmail",
# "sendgrid", or "resend". If unset (or its key is missing), the mailer
# falls back to logging the link instead of sending it — safe default for
# local dev.
EMAIL_PROVIDER=gmail

# Gmail SMTP: fastest to test with, no sender/domain verification at all —
# just an app password on a real Gmail account (myaccount.google.com/apppasswords,
# requires 2-Step Verification enabled). Expect mail to land in spam until a
# real domain is verified — fine for testing, not for real users.
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD=

# SendGrid: https://app.sendgrid.com/settings/api_keys — free tier, only
# needs Single Sender Verification (verify one email address), no domain
# required. EMAIL_FROM must be that exact verified sender address.
SENDGRID_API_KEY=
EMAIL_FROM="you@example.com"

# Resend: https://resend.com/api-keys — free tier. Without a verified
# domain, Resend only lets you send FROM onboarding@resend.dev and only TO
# the email address your Resend account is signed up with.
RESEND_API_KEY=
